{
  "name": "issue-runner-herdr",
  "version": "0.1.2",
  "description": "Herdr 0.9.5 terminal plugin for Issue Runner Core contract v2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/index.d.ts"
  ],
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}\" --no-error-on-unmatched-pattern",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.*\"",
    "test:package": "node --test tests/package/artifact.test.ts",
    "release:accept": "node --test tests/package/artifact.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "bin": {
    "issue-runner-herdr": "./dist/cli.js"
  },
  "dependencies": {
    "issue-runner-core": "0.1.3"
  },
  "keywords": [
    "issue-runner",
    "herdr",
    "terminal",
    "terminal-plugin",
    "cli",
    "github-issues",
    "workflow-automation",
    "ai-agents",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuddyLabsCo/issue-runner-herdr.git"
  },
  "homepage": "https://github.com/BuddyLabsCo/issue-runner-herdr#readme",
  "bugs": {
    "url": "https://github.com/BuddyLabsCo/issue-runner-herdr/issues"
  }
}
